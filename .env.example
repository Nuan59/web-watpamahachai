DATABASE_URL="file:./dev.db"
SESSION_SECRET="set-a-long-random-string-at-least-32-chars"
# Public address of the site, no trailing slash (canonical links, sitemap, link previews).
SITE_URL="http://localhost:3030"
# Running on a computer at home over plain http (no HTTPS)? Keep this on so logging in works
# from other devices on the same network. Turn it off once the site is behind HTTPS.
# INSECURE_COOKIE=1
